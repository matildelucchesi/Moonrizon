# Copiare in deploy/.env.prod (non va in Git).

# Dominio dell'API: il record DNS (A) deve puntare all'IP pubblico del server.
# Senza dominio si può usare sslip.io, es. 203-0-113-10.sslip.io
API_DOMAIN=api.example.com

# Origini del frontend autorizzate (separate da virgola, senza slash finale).
CORS_ORIGINS=https://moonrizon.pages.dev,https://moonrizon.example.com

# Cartella sul server con i dati (vedi deploy/README.md).
DATA_ROOT=/opt/moonrizon

# Memoria massima del backend (Rasterio + raster in RAM).
BACKEND_MEM_LIMIT=4g
