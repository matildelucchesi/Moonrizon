# Copiare in .env solo per cambiare un valore: tutti hanno un default nel codice.
# Docker Compose legge .env sia per le porte sia per le variabili del backend.

# --- Porte sul computer host ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Versione di produzione (docker compose --profile prod up web)
WEB_PORT=8080

# --- Ricaricamento automatico in Docker ---
# true = controlla i file a intervalli (necessario su Windows, predefinito).
# false = usa gli eventi del file system: più reattivo su macOS e Linux, e vede
# subito i file nuovi.
WATCH_POLLING=true

# --- Frontend ---
# api = cataloghi backend (predefinito); demo = dati dimostrativi.
VITE_DATA_SOURCE=api

# --- Backend: fonti dati (vedi docs/criteri-algoritmo.md, References) ---
HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api
MOONTREK_BASE_URL=https://trek.nasa.gov/moon
PDS_LOLA_BASE_URL=https://pds-geosciences.wustl.edu/lro/lro-l-lola-3-rdr-v1/lrolol_1xxx

# Timeout delle richieste HTTP verso le fonti, in secondi.
HTTP_TIMEOUT_S=60

# Siti calcolati in contemporanea (terreno e scenari). 4 = uno per sito nel confronto.
# Le richieste a JPL Horizons restano comunque una alla volta.
MEOWRIZON_SCIENTIFIC_WORKERS=4

# Indirizzi del frontend autorizzati a chiamare le API direttamente (separati da virgola).
# Non serve passando dal proxy /api di Vite o nginx.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
